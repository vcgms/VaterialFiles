<?xml version="1.0" encoding="utf-8"?>
<menu
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AlwaysShowAction">

    <item
        android:id="@+id/action_search"
        android:icon="@drawable/search_icon_control_normal_24dp"
        android:orderInCategory="100"
        android:title="@string/search"
        app:actionViewClass="dev.vcgms.aapp.vaterialfiles.ui.FixQueryChangeSearchView"
        app:showAsAction="always|collapseActionView" />

    <!-- Opens the custom view/sort popup (view-mode icon row + sort list). -->
    <item
        android:id="@+id/action_view_sort"
        android:icon="@drawable/sort_icon_control_normal_24dp"
        android:orderInCategory="100"
        android:title="@string/file_list_action_view_sort"
        app:showAsAction="always" />

    <!-- Opens the custom overflow popup (icon row + icon list items). -->
    <item
        android:id="@+id/action_overflow"
        android:icon="@drawable/more_vertical_icon_control_normal_24dp"
        android:orderInCategory="100"
        android:title="@string/more"
        app:showAsAction="always" />
</menu>
