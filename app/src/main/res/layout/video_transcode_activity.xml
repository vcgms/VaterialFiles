<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <dev.vcgms.aapp.vaterialfiles.ui.CoordinatorAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/file_list_toolbar_height"
            app:popupTheme="@style/ThemeOverlay.MaterialFiles.ActionBarPopup.BelowToolbar" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="6dp"
            android:textAppearance="?textAppearanceListItemSecondary"
            android:visibility="gone" />
    </dev.vcgms.aapp.vaterialfiles.ui.CoordinatorAppBarLayout>

    <dev.vcgms.aapp.vaterialfiles.ui.CoordinatorScrollingFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <me.zhanghai.android.fastscroll.FastScrollNestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_edge_margin">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outputNameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/video_transcode_output_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/outputNameEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/timelineSummaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?textAppearanceListItemSecondary"
                    android:visibility="gone" />

                <TextView
                    style="@style/VideoTranscodeSectionTitle"
                    android:text="@string/video_transcode_video_codec" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/videoCodecGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/videoCodecAvc"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H.264 (AVC)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/videoCodecHevc"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H.265 (HEVC)" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/VideoTranscodeSectionTitle"
                    android:text="@string/video_transcode_resolution" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resolutionGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/resolutionOriginal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_transcode_original" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/resolution1080p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1080P" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/resolution720p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720P" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/resolution480p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="480P" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/VideoTranscodeSectionTitle"
                    android:text="@string/video_transcode_bit_rate" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/bitRateGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitRateOriginal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_transcode_original" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitRate2m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Mbps" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitRate4m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Mbps" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitRate8m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 Mbps" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/VideoTranscodeSectionTitle"
                    android:text="@string/video_transcode_frame_rate" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/frameRateGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/frameRateOriginal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_transcode_original" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/frameRate60"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 fps" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/frameRate30"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 fps" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/frameRate25"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 fps" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/frameRate24"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 fps" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/VideoTranscodeSectionTitle"
                    android:text="@string/video_transcode_advanced" />

                <TextView
                    style="@style/VideoTranscodeSubTitle"
                    android:text="@string/video_transcode_bitrate_mode" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/bitrateModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitrateModeVbr"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VBR" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/bitrateModeCbr"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CBR" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/profileTitle"
                    style="@style/VideoTranscodeSubTitle"
                    android:text="@string/video_transcode_profile" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/profileGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/profileMain"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/profileHigh"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/profileBaseline"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baseline" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </me.zhanghai.android.fastscroll.FastScrollNestedScrollView>
    </dev.vcgms.aapp.vaterialfiles.ui.CoordinatorScrollingFrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
